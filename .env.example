# ParkTrack KW - Environment Variables Template
# 
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to Git - it will be in .gitignore

# ===============================================
# Required API Keys
# ===============================================

# LocationIQ API Key - Required for destination search functionality
# Get your free API key at: https://locationiq.com
# 1. Sign up at https://locationiq.com
# 2. Copy your API key from the dashboard
# 3. Paste it below (remove the example key)
REACT_APP_LOCATIONIQ_API_KEY=pk.3d9963d4d296a4fb8a4eb46bf6cc3bef

# ===============================================
# Optional Configuration
# ===============================================

# These variables are set automatically by Create React App
# You usually don't need to change these

# NODE_ENV is automatically set by npm scripts (development/production)
# NODE_ENV=development

# ===============================================
# Vercel Deployment
# ===============================================
#
# When deploying to Vercel:
# 1. Add REACT_APP_LOCATIONIQ_API_KEY to Vercel environment variables
# 2. Make sure the variable name is EXACTLY: REACT_APP_LOCATIONIQ_API_KEY
# 3. Redeploy after adding environment variables
#
# DO NOT add your .env file to Vercel - use the web interface instead
#
# ===============================================
